# Профиль с Caddy, если другого HTTPS-прокси нет и порты 80/443 свободны.
# Установщик создаёт .env.public командой python3 scripts/kamerton.py init caddy.
# Настройте файл до первого start. Ручной Compose — отдельный путь, docs/public-access.md.
# Укажите своё DNS-имя без схемы, порта и пути. Паролю здесь не место.
KAMERTON_DOMAIN=stt.example.org
# Интерфейс сервера для HTTP/HTTPS. Для VPN укажите его IPv4-адрес.
CADDY_BIND=0.0.0.0
# Если эта подсеть занята LAN/VPN или Docker, поменяйте подсеть и оба адреса вместе.
KAMERTON_SUBNET=172.30.91.0/28
KAMERTON_CADDY_IP=172.30.91.2
KAMERTON_APP_IP=172.30.91.3
