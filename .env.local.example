###############################################################################
# Наложение Compose для разработки, не профиль `setup local` установщика.
# Запускайте в отдельной копии репозитория, не над каталогами установки CLI.
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#
# Значения отсюда перебивают окружение контейнера из `.env`; дублировать весь
# файл не нужно.
#
# HOST_BIND и HOST_PORT задавайте в корневом `.env` или в окружении оболочки.
# Чтобы брать подстановки из обоих файлов, передайте Compose два флага в этом
# порядке: --env-file .env --env-file .env.local (последний имеет приоритет).
# Если `.env` нет, передайте только --env-file .env.local.
###############################################################################

# Не разворачивать модель при старте контейнера. На своей машине это чаще мешает:
# вы собираете образ, а движок в это время тянет 230 МБ весов и греет процессор.
# Голову развернёте кнопкой в консоли, когда она понадобится.
AUTOSTART=0

# Подробные логи движка: на разработке они полезнее, чем на проде.
LOG_LEVEL=debug
