###############################################################################
# Поведение сервиса при запуске на своей машине. Работает вместе с наложением:
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#
# Здесь только то, что должно отличаться от боевого; значения отсюда перебивают
# `.env`, поэтому дублировать весь файл не нужно.
#
# ВАЖНО: порт сюда писать бесполезно. `HOST_PORT` подставляется в сам
# `docker-compose.yml`, а compose берёт подстановки только из `.env` в корне
# проекта — этот файл до них не доходит. Меняйте порт в `.env`.
###############################################################################

# Не разворачивать модель при старте контейнера. На своей машине это чаще мешает:
# вы собираете образ, а движок в это время тянет 230 МБ весов и греет процессор.
# Голову развернёте кнопкой в консоли, когда она понадобится.
AUTOSTART=0

# Подробные логи движка: на разработке они полезнее, чем на проде.
LOG_LEVEL=debug
