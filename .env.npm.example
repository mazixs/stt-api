# Для ручного Compose скопируйте в .env.npm. CLI установки создаёт этот файл сам.
# В Arcane задайте эти переменные в стеке.
# IP интерфейса Docker-хоста, доступного прокси. Не используйте 0.0.0.0 или ::.
# Ограничьте доступ к опубликованному порту только адресом NPM в правилах сети/Docker.
# Не пробрасывайте этот порт в интернет.
KAMERTON_BIND=192.0.2.10
KAMERTON_PORT=8812

# Внешний HTTPS-адрес сайта без пути, завершающего / и явного :443.
PUBLIC_ORIGIN=https://stt.example.org
# Один фактический IP TCP-соседа, который видит приложение (не X-Forwarded-For).
# При NAT это может быть адрес трансляции; не подставляйте IP браузера или подсеть.
TRUSTED_PROXY_IP=192.0.2.20

# Для локального checkout оставьте «.». В Arcane укажите абсолютные пути на Docker-хосте.
# Каталоги должны существовать: для чистой установки создайте их до init и up.
# Если Arcane синхронизирует только YAML, выберите Git-контекст официального репозитория:
# KAMERTON_BUILD_CONTEXT=https://github.com/mazixs/stt-api.git#v1.6.0
# Используйте тег или полный SHA версии, совместимой с манифестом.
KAMERTON_BUILD_CONTEXT=.
KAMERTON_DATA_DIR=./data
KAMERTON_MODEL_DIR=./models
# Это тег локальной сборки, не имя опубликованного образа. Для второго стека задайте другой.
KAMERTON_IMAGE=stt-api-console:npm

# Пароль и клиентские API-ключи не задаются здесь, только при одноразовой операции CLI.
# AUTOSTART=1
# MAX_UPLOAD_MB=150
# ENABLE_MODEL_COMPARE=0
# ENABLE_JOBS=0
# LOG_LEVEL=info
