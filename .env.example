###############################################################################
# Скопируйте этот файл в .env и при необходимости поправьте значения.
#   cp .env.example .env && docker compose up -d
# Все переменные необязательны — без .env сервис запустится на настройках ниже.
#
# Сам `.env` в git не попадает (см. .gitignore) — ключи и токены держите только в
# нём. Правки применяются пересозданием контейнера: `docker compose up -d`.
#
# ВАЖНО: значения модели ниже — то, что предвыбрано в консоли. После первого
# развёртывания приоритет у `data/state.json`, поэтому смена MODEL_VARIANT,
# PUNCTUATION, ITN, VAD, POOL_SIZE или HOTWORDS_* в этом файле ничего не изменит в
# работающем движке, пока вы не нажмёте «Развернуть» в консоли. Настройки самой
# консоли (порт, ключ, лимит загрузки, автозапуск) читаются при старте контейнера.
###############################################################################

# Порт на сервере, по которому открывается веб-консоль и API.
HOST_PORT=8091

# Ключ доступа. Пусто — сервис открыт всем, кто дотянется до порта.
# Если задан, нужен заголовок Authorization: Bearer <ключ> — и для /v1/..., и для
# /api/..., включая документацию на /api/docs. Открытым остаётся только /health, чтобы
# healthcheck контейнера не считал исправный сервис упавшим. Там, где браузер не умеет
# заголовок (/api/events и /api/docs), ключ принимается как ?api_key=<ключ>.
# Сгенерировать: openssl rand -hex 24
API_KEY=

###############################################################################
# Начальный контекст (глоссарий)
# Имена, термины и названия, которые движок должен узнавать. Работает на этапе
# распознавания (hotword-биасинг), а не правкой готового текста.
# Разделители — запятая или перевод строки, вес фразы — после вертикальной черты.
###############################################################################
INITIAL_CONTEXT=

# Сила подсказки, работает на всех четырёх головах. 5.0 — значение самого движка:
# глоссарий, чьих слов в записи нет, не меняет текст ни на байт, а слова из него
# поправляет. Поднимать выше стоит, только если нужное слово всё равно не узнаётся,
# и лучше по одному шагу — подсказка соревнуется с тем, что модель действительно
# услышала. Фразы, которые голова не умеет написать, движок отбрасывает и называет
# их в логе; консоль показывает их же рядом с глоссарием.
HOTWORDS_BOOST=5.0

# Добавить встроенный словарь русских брендов и аббревиатур движка (0 или 1).
HOTWORDS_DEFAULT=0

###############################################################################
# Модель и качество распознавания
# Это значения по умолчанию для веб-консоли: конкретную голову вы выбираете
# кнопкой «Развернуть», и она запоминается между перезапусками.
###############################################################################

# rnnt | e2e_rnnt | ml_ctc | ml_ctc_large
MODEL_VARIANT=rnnt

# Пунктуация и регистр: auto | on | off  (auto = включено для rnnt)
PUNCTUATION=auto

# Числа словами → цифрами: auto | on | off
ITN=auto

# Пропуск тишины перед распознаванием: 0 или 1. Полезно для длинных записей.
VAD=0

# Сколько распознаваний движок держит одновременно, от 1 до 8.
# 1 — минимальная задержка и ~120 МиБ памяти, лучший выбор для диктовки; каждая
# добавленная сессия прибавляет ~20 МиБ.
POOL_SIZE=1

###############################################################################
# Прочее
###############################################################################

# Разворачивать последнюю модель при старте контейнера (0 или 1).
AUTOSTART=1

# Максимальный размер загружаемого файла, МБ. 150 — это около 105 минут MP3 на
# 192 кбит/с; предел движку консоль задаёт сама, поднимать его отдельно не нужно.
# Считайте не только по диску: файл целиком лежит в памяти консоли, пока уходит в
# движок, — замер на 147 МиБ есть в docs/decisions.md.
MAX_UPLOAD_MB=150

# Очередь движка для длинных файлов и пакетной обработки (0 или 1).
ENABLE_JOBS=0

# Токен Hugging Face. Нужен, только если ваш провайдер режет анонимные загрузки:
# лёгкие INT8-веса движок берёт с GitHub Releases, а не с HF.
HF_TOKEN=

# Подробность логов: error | warn | info | debug
LOG_LEVEL=info

# Версия движка, из образа которой берётся бинарник при сборке. Пусто — берётся
# закреплённая версия из docker-compose.yml, и это нормальный режим: здесь значение
# не дублируется, чтобы два файла не разъезжались. Заполняйте, только если нужно
# собрать образ на другой версии, — и помните, что обновление движка уже дважды
# меняло поведение глоссария и набор поддерживаемых форматов.
GIGASTT_TAG=
