###############################################################################
# Скопируйте этот файл в .env и при необходимости поправьте значения.
#   cp .env.example .env && docker compose up -d
# Все переменные необязательны - без .env сервис запустится на значениях по
# умолчанию из кода.
#
# Сам .env в git не попадает (см. .gitignore) - ключи и токены держите только в
# нем. Правки применяются пересозданием контейнера: docker compose up -d.
#
# Настройки движка (голова, пунктуация, VAD, словарь, глоссарий) выбираются в
# веб-консоли и хранятся в data/state.json - это единственный штатный способ.
# Строки ниже в разделах "Начальный контекст" и "Модель" закомментированы намеренно:
# раскомментируйте их, только если разворачиваете сервис без интерфейса и хотите,
# чтобы первая же загрузка контейнера подняла нужную голову сама. После первого
# развертывания выбор в консоли сильнее, а если раскомментированная строка расходится
# с ним, консоль покажет это в разделе "Настройки запуска" с кнопкой "Развернуть с
# настройками .env". Настройки самой консоли (порт, ключ, лимит, автозапуск, логи)
# читаются при старте контейнера и в консоли не выбираются.
###############################################################################

# Порт на сервере, по которому открывается веб-консоль и API.
HOST_PORT=8091

# Ключ доступа. Пусто - сервис открыт всем, кто дотянется до порта.
# Если задан, нужен заголовок Authorization: Bearer <ключ> - и для /v1/..., и для
# /api/..., включая документацию на /api/docs. Открытым остается только /health, чтобы
# healthcheck контейнера не считал исправный сервис упавшим. Там, где браузер не умеет
# заголовок (/api/events и /api/docs), ключ принимается как ?api_key=<ключ>.
# Сгенерировать: openssl rand -hex 24
API_KEY=

###############################################################################
# Начальный контекст (глоссарий) - только для развертывания без консоли
# Штатно глоссарий правится в веб-консоли и лежит в data/hotwords.txt.
###############################################################################

# Имена, термины и названия, которые движок должен узнавать: hotword-биасинг на
# этапе распознавания, а не правка готового текста. Разделители - запятая или
# перевод строки, вес фразы - после вертикальной черты. По умолчанию пусто.
# INITIAL_CONTEXT=

# Сила подсказки, работает на всех четырех головах. По умолчанию 5.0 - значение
# самого движка: глоссарий, чьих слов в записи нет, не меняет текст ни на байт.
# Поднимать выше стоит, только если нужное слово все равно не узнается, и лучше по
# одному шагу: подсказка соревнуется с тем, что модель действительно услышала.
# HOTWORDS_BOOST=5.0

# Встроенный словарь брендов движка (0 или 1), по умолчанию 1. Внутри 30 бытовых
# названий строчной кириллицей: эпл, айфон, самсунг, яндекс, озон, вайлдберриз и
# такие же. Технической лексике он не помогает - для нее есть глоссарий выше.
# Выключайте, если словарь мешает: замер показал, что на 27 минутах диктовки он
# изменил одно слово из 2654 (docs/research/head-choice-and-wer.md).
# HOTWORDS_DEFAULT=1

###############################################################################
# Модель и качество распознавания - только для развертывания без консоли
# Штатно голова выбирается кнопкой "Развернуть" и запоминается в data/state.json.
###############################################################################

# Голова: rnnt | e2e_rnnt | ml_ctc | ml_ctc_large. По умолчанию rnnt.
# MODEL_VARIANT=rnnt

# Пунктуация и регистр: auto | on | off, по умолчанию auto. auto включает пунктуацию
# только для rnnt; для ml_ctc и ml_ctc_large ставьте on вручную, иначе текст без знаков.
# PUNCTUATION=auto

# Числа словами в цифры: auto | on | off, по умолчанию auto.
# ITN=auto

# Пропуск тишины перед распознаванием: 0 или 1, по умолчанию 0. Экономит время на
# длинных записях и меняет текст, поэтому для диктовки выключен.
# VAD=0

# Сколько распознаваний движок держит одновременно, от 1 до 8. По умолчанию 1:
# минимальная задержка и около 120 МиБ памяти, лучший выбор для диктовки; каждая
# добавленная сессия прибавляет около 20 МиБ.
# POOL_SIZE=1

###############################################################################
# Прочее
###############################################################################

# Разворачивать последнюю модель при старте контейнера (0 или 1). Если голова еще не
# выбрана ни в консоли, ни в .env, автозапуск ничего не поднимает, и консоль просит
# нажать "Развернуть".
AUTOSTART=1

# Максимальный размер загружаемого файла, МБ. 150 - это около 105 минут MP3 на
# 192 кбит/с; предел движку консоль задает сама, поднимать его отдельно не нужно.
# Считайте не только по диску: файл целиком лежит в памяти консоли, пока уходит в
# движок, - замер на 147 МиБ есть в docs/decisions.md.
MAX_UPLOAD_MB=150

# Очередь движка для длинных файлов и пакетной обработки (0 или 1).
ENABLE_JOBS=0

# Токен Hugging Face. Нужен, только если ваш провайдер режет анонимные загрузки:
# легкие INT8-веса движок берет с GitHub Releases, а не с HF.
HF_TOKEN=

# Подробность логов: error | warn | info | debug
LOG_LEVEL=info

# Версия движка, из образа которой берется бинарник при сборке. Пусто - берется
# закрепленная версия из docker-compose.yml, и это нормальный режим: здесь значение
# не дублируется, чтобы два файла не разъезжались. Заполняйте, только если нужно
# собрать образ на другой версии, - и помните, что обновление движка уже дважды
# меняло поведение глоссария и набор поддерживаемых форматов.
GIGASTT_TAG=
